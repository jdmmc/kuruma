# 7 本の並走レーン。立った場所から +X へ 200 ブロック、+Z 側へ 56 ブロック。
# 乗り換えて路面ごとの土煙を見比べるためのもの。
#
#   Z+0..7   石         舗装（dust 0.0）……何も出ないのが正しい
#   Z+8..15  草         土（0.85）
#   Z+16..23 砂利       砂利（0.7）
#   Z+24..31 砂         砂（1.0）
#   Z+32..39 赤い砂     砂（1.0）……色が足元のブロックから来ることの確認
#   Z+40..47 雪         雪（0.9）
#   Z+48..55 氷         氷（0.0）……いちばん滑るのに何も出ないのが正しい
function kurumatest:setup

# 上を空ける。fill は 1 回 32768 ブロックまでなので 2 回に分ける
fill ~-1 ~ ~-1 ~100 ~4 ~56 air
fill ~101 ~ ~-1 ~200 ~4 ~56 air

fill ~-1 ~-1 ~-1 ~200 ~-1 ~56 stone
fill ~ ~-1 ~8 ~200 ~-1 ~15 grass_block
fill ~ ~-1 ~16 ~200 ~-1 ~23 gravel
fill ~ ~-1 ~24 ~200 ~-1 ~31 sand
fill ~ ~-1 ~32 ~200 ~-1 ~39 red_sand
fill ~ ~-1 ~40 ~200 ~-1 ~47 snow_block
fill ~ ~-1 ~48 ~200 ~-1 ~55 packed_ice

# スタートライン
fill ~-1 ~-1 ~-1 ~-1 ~-1 ~56 white_concrete

tellraw @s {"text":"[kuruma] 並走レーンを作りました。東（+X）へ 200m。","color":"green"}
